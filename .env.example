# Optional: local Yahoo parquet cache for stock pages / board history.
# Default is backend/data/price_cache (created on demand).
# For research tapes (do NOT commit this path into production config):
# SAINT_PRICE_CACHE=/absolute/path/to/New Folder With Items/data/price_cache
SAINT_QUOTE_TTL_S=120
SAINT_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# AI stock helper (on-demand). Gemini preferred for freemium.
SAINT_AI_PROVIDER=gemini
SAINT_GEMINI_API_KEY=
SAINT_GEMINI_MODEL=gemini-flash-latest

# Optional OpenAI fallback
SAINT_OPENAI_API_KEY=
SAINT_OPENAI_MODEL=gpt-4o-mini

# Telegram alerts (ENTRY on high-bar buy; EXIT on giveback/trail/fade)
SAINT_ALERTS_ENABLED=false
SAINT_TELEGRAM_BOT_TOKEN=
SAINT_TELEGRAM_CHAT_ID=
# Optional: require ?key=... on /api/alerts/tick and /api/alerts/test
SAINT_ALERTS_SECRET=
SAINT_ALERTS_MIN_CONVICTION=60
SAINT_ALERTS_MAX_NEWS_AGE_MINS=360
# Soft by default — board rules fire the alert; tech/AI are notes only
SAINT_ALERTS_REQUIRE_TECHNICALS=false
SAINT_ALERTS_AI_COMMENT=true
# Demote buy long/short → watch when volume/price confirmation fails
SAINT_ACTION_CONFIRM_ENABLED=true

# Fyers — realtime Nifty breadth quotes (login from app header)
# Create an app at https://myapi.fyers.in — redirect must match exactly.
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html
# Optional: seed token (otherwise paste auth code in the UI after login)
# FYERS_ACCESS_TOKEN=
# FYERS_TOKEN_PATH=/tmp/saint_fyers_token.json

# MongoDB Atlas — paper trades (set on Render too)
SAINT_MONGODB_URI=
SAINT_MONGODB_DB=saint
