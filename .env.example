# Optional overrides
SAINT_PRICE_CACHE=/Users/akashcs/Chartink/Chartink conditions/New Folder With Items/data/price_cache
SAINT_QUOTE_TTL_S=120
SAINT_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# AI stock helper (on-demand). Gemini preferred for freemium.
SAINT_AI_PROVIDER=gemini
SAINT_GEMINI_API_KEY=
SAINT_GEMINI_MODEL=gemini-flash-latest

# Optional OpenAI fallback
SAINT_OPENAI_API_KEY=
SAINT_OPENAI_MODEL=gpt-4o-mini

# Telegram alerts (ENTRY on high-bar buy; EXIT on giveback/trail/fade)
SAINT_ALERTS_ENABLED=false
SAINT_TELEGRAM_BOT_TOKEN=
SAINT_TELEGRAM_CHAT_ID=
# Optional: require ?key=... on /api/alerts/tick and /api/alerts/test
SAINT_ALERTS_SECRET=
SAINT_ALERTS_MIN_CONVICTION=60
SAINT_ALERTS_MAX_NEWS_AGE_MINS=360
# Soft by default — board rules fire the alert; tech/AI are notes only
SAINT_ALERTS_REQUIRE_TECHNICALS=false
SAINT_ALERTS_AI_COMMENT=true
